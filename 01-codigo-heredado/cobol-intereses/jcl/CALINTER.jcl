//CALINTMS JOB (CTB,0420),'INTERESES MENSUAL',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//PASO010  EXEC PGM=IEFBR14
//BORRA    DD DSN=PROD.CARTERA.MOVINT.MENSUAL,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,0)
//*
//PASO020  EXEC PGM=SORT
//SORTIN   DD DSN=PROD.CARTERA.CREDITOS,DISP=SHR
//SORTOUT  DD DSN=&&CREDORD,DISP=(NEW,PASS),
//            SPACE=(CYL,(50,10)),DCB=(RECFM=FB,LRECL=80)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(11,8,CH,A,1,10,CH,A)
/*
//PASO030  EXEC PGM=CALINTER,COND=(4,LT)
//STEPLIB  DD DSN=PROD.CARTERA.LOADLIB,DISP=SHR
//CREDIN   DD DSN=&&CREDORD,DISP=(OLD,DELETE)
//PARMIN   DD DSN=PROD.CARTERA.PARAM(FECCORTE),DISP=SHR
//MOVOUT   DD DSN=PROD.CARTERA.MOVINT.MENSUAL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,5)),DCB=(RECFM=FB,LRECL=80)
//CREDOUT  DD DSN=PROD.CARTERA.CREDITOS.NUEVO,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,10)),DCB=(RECFM=FB,LRECL=80)
//REPOUT   DD SYSOUT=(R,,CTB1)
//*
//PASO040  EXEC PGM=IDCAMS,COND=(0,NE,PASO030)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE PROD.CARTERA.CREDITOS
  ALTER  PROD.CARTERA.CREDITOS.NUEVO -
         NEWNAME(PROD.CARTERA.CREDITOS)
/*
