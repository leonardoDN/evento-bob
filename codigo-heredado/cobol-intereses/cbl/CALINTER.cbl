012800 PROCEDURE DIVISION.
012900 0000-PRINCIPAL.
013000     PERFORM 1000-INICIO.
013100     PERFORM 2000-PROCESA-CREDITO THRU 2000-EXIT
013200         UNTIL FIN-CREDITOS.
013300     PERFORM 9000-FIN.
013400     STOP RUN.
013500 1000-INICIO.
013600     OPEN INPUT  CREDITOS PARAMS
013700         OUTPUT MOVTOS REPORTE CREDNVO.
013800     READ PARAMS
013900         AT END MOVE ZEROS TO PR-FECHA-CORTE.
014000     MOVE PR-FECHA-CORTE TO WS-FECHA-CORTE.
014100     IF WS-FC-AA < 50                                             Y2K9811
014200         COMPUTE WS-FC-AAAA = 2000 + WS-FC-AA                     Y2K9811
014300     ELSE                                                         Y2K9811
014400         COMPUTE WS-FC-AAAA = 1900 + WS-FC-AA                     Y2K9811
014500     END-IF.                                                      Y2K9811
014600     MOVE PR-FECHA-CORTE TO LE-FECHA.
014700     WRITE REG-REPORTE FROM WS-LIN-ENCAB.
014800     PERFORM 2900-LEE-CREDITO.
014900 2000-PROCESA-CREDITO.
015000     ADD 1 TO WS-CT-LEIDOS.
015100     MOVE ZEROS TO WS-INT-PERIODO WS-INT-MORA.
015200     MOVE SPACE TO CR-MARCA.
015300     PERFORM 2100-DETERMINA-TASA.
015400     IF NOT TASA-ENCONTRADA
015500         ADD 1 TO WS-CT-SIN-TASA
015600         WRITE REG-CREDNVO FROM REG-CREDITO
015700         PERFORM 2900-LEE-CREDITO
015800         GO TO 2000-EXIT
015900     END-IF.
016000     PERFORM 2200-CALCULA-DIAS.
016100     IF CR-SALDO-CAP < 500.00                                     ARS0703
016200         MOVE 'C' TO CR-MARCA                                     ARS0703
016300         ADD 1 TO WS-CT-CONDONADO                                 ARS0703
016400     ELSE
016500         IF CR-DIAS-ATRASO > 180
016600             PERFORM 2500-CUENTAS-ORDEN
016700         ELSE
016800             PERFORM 2300-INTERES-ORDINARIO
016900             IF CR-DIAS-ATRASO > 90
017000                 PERFORM 2400-INTERES-MORATORIO
017100             END-IF
017200         END-IF
017300     END-IF.
017400     PERFORM 2600-ACTUALIZA-CREDITO.
017500     PERFORM 2700-ESCRIBE-REPORTE.
017600     PERFORM 2900-LEE-CREDITO.
017700 2000-EXIT.
017800     EXIT.
017900 2100-DETERMINA-TASA.
018000     MOVE 'N' TO WS-SW-TASA.
018100     SET IX-TASA TO 1.
018200     SEARCH TT-ENTRADA
018300         AT END
018400             MOVE 'N' TO WS-SW-TASA
018500         WHEN TT-PRODUCTO (IX-TASA) = CR-PRODUCTO
018600             MOVE 'S' TO WS-SW-TASA
018700             MOVE TT-BASE-DIAS (IX-TASA) TO WS-BASE-DIAS
018800             IF CR-TASA-PACT > ZERO
018900                 MOVE CR-TASA-PACT TO WS-TASA-APLIC
019000             ELSE
019100                 MOVE TT-TASA-BASE (IX-TASA) TO WS-TASA-APLIC
019200             END-IF
019300     END-SEARCH.
019400     IF TASA-ENCONTRADA
019500         EVALUATE TRUE
019600             WHEN CR-EMPLEADO
019700                 IF WS-TASA-APLIC > 4.0000
019800                     SUBTRACT 4.0000 FROM WS-TASA-APLIC
019900                 ELSE
020000                     MOVE ZERO TO WS-TASA-APLIC
020100                 END-IF
020200             WHEN CR-PENSIONADO                                   LMH1102
020300                 IF WS-TASA-APLIC > 18.0000                       LMH1102
020400                     MOVE 18.0000 TO WS-TASA-APLIC                LMH1102
020500                 END-IF                                           LMH1102
020600             WHEN CR-PREFERENTE
020700                 IF CR-ANTIG-ANIOS > 5
020800                     SUBTRACT 1.5000 FROM WS-TASA-APLIC
020900                 END-IF
021000             WHEN OTHER
021100                 CONTINUE
021200         END-EVALUATE
021300     END-IF.
021400 2200-CALCULA-DIAS.
021500     IF CR-UC-MM = WS-FC-MM AND CR-UC-AA = WS-FC-AA
021600         COMPUTE WS-DIAS-PERIODO = WS-FC-DD - CR-UC-DD
021700     ELSE
021800         COMPUTE WS-DIAS-PERIODO =
021900             WS-DIAS-MES (CR-UC-MM) - CR-UC-DD + WS-FC-DD
022000         MOVE CR-UC-MM TO WS-MES-AUX
022100         ADD 1 TO WS-MES-AUX
022200         PERFORM UNTIL WS-MES-AUX = WS-FC-MM
022300             IF WS-MES-AUX > 12
022400                 MOVE 1 TO WS-MES-AUX
022500             ELSE
022600                 ADD WS-DIAS-MES (WS-MES-AUX) TO WS-DIAS-PERIODO
022700                 ADD 1 TO WS-MES-AUX
022800             END-IF
022900         END-PERFORM
023000     END-IF.
023100     IF WS-DIAS-PERIODO > 31 AND CR-PRODUCTO NOT = 'HIP'          ARS0703
023200         MOVE 30 TO WS-DIAS-PERIODO                               ARS0703
023300     END-IF.                                                      ARS0703
023400 2300-INTERES-ORDINARIO.
023500     COMPUTE WS-INT-DIARIO =
023600         CR-SALDO-CAP * WS-TASA-APLIC / 100 / WS-BASE-DIAS.
023700     COMPUTE WS-INT-PERIODO ROUNDED =
023800         WS-INT-DIARIO * WS-DIAS-PERIODO.
023900     MOVE 'I' TO MV-TIPO.
024000     MOVE WS-TASA-APLIC TO MV-TASA-APLIC.
024100     MOVE WS-INT-PERIODO TO MV-IMPORTE.
024200     PERFORM 2800-ESCRIBE-MOVTO.
024300     ADD WS-INT-PERIODO TO WS-TOT-INTERES.
024400     ADD 1 TO WS-CT-ORDINARIO.
024500 2400-INTERES-MORATORIO.
024600     COMPUTE WS-TASA-MORA = WS-TASA-APLIC * 1.5.
024700     IF WS-TASA-MORA > 60.0000                                    LMH1102
024800         MOVE 60.0000 TO WS-TASA-MORA                             LMH1102
024900     END-IF.                                                      LMH1102
025000     COMPUTE WS-INT-MORA ROUNDED =
025100         CR-SALDO-CAP * (WS-TASA-MORA - WS-TASA-APLIC) / 100
025200         / 360 * WS-DIAS-PERIODO.
025300     MOVE 'M' TO MV-TIPO.
025400     MOVE WS-TASA-MORA TO MV-TASA-APLIC.
025500     MOVE WS-INT-MORA TO MV-IMPORTE.
025600     PERFORM 2800-ESCRIBE-MOVTO.
025700     ADD WS-INT-MORA TO WS-TOT-MORA.
025800     ADD 1 TO WS-CT-MORA.
025900 2500-CUENTAS-ORDEN.
026000     PERFORM 2300-INTERES-ORDINARIO.
026100     SUBTRACT 1 FROM WS-CT-ORDINARIO.
026200     SUBTRACT WS-INT-PERIODO FROM WS-TOT-INTERES.
026300     ADD WS-INT-PERIODO TO CR-INT-ORDEN.
026400     MOVE ZERO TO WS-INT-PERIODO.
026500     MOVE 'O' TO CR-MARCA.
026600     ADD 1 TO WS-CT-ORDEN.
026700 2600-ACTUALIZA-CREDITO.
026800     ADD WS-INT-PERIODO WS-INT-MORA TO CR-SALDO-CAP.
026900     ADD WS-INT-PERIODO TO CR-INT-ACUM-ANIO.
027000     IF WS-FC-MM = 12
027100         MOVE ZERO TO CR-INT-ACUM-ANIO
027200     END-IF.
027300     MOVE WS-FC-AA TO CR-UC-AA.
027400     MOVE WS-FC-MM TO CR-UC-MM.
027500     MOVE WS-FC-DD TO CR-UC-DD.
027600     WRITE REG-CREDNVO FROM REG-CREDITO.
027700 2700-ESCRIBE-REPORTE.
027800     MOVE CR-NUM-CRED TO LD-NUM-CRED.
027900     MOVE CR-PRODUCTO TO LD-PRODUCTO.
028000     MOVE CR-TIPO-CLI TO LD-TIPO.
028100     MOVE CR-SALDO-CAP TO LD-SALDO.
028200     MOVE WS-TASA-APLIC TO LD-TASA.
028300     MOVE WS-DIAS-PERIODO TO LD-DIAS.
028400     COMPUTE LD-INTERES = WS-INT-PERIODO + WS-INT-MORA.
028500     MOVE CR-MARCA TO LD-MARCA.
028600     WRITE REG-REPORTE FROM WS-LIN-DETALLE.
028700 2800-ESCRIBE-MOVTO.
028800     MOVE CR-NUM-CRED TO MV-NUM-CRED.
028900     COMPUTE WS-FECHA-MOVTO =
029000         WS-FC-AAAA * 10000 + WS-FC-MM * 100 + WS-FC-DD.
029100     MOVE WS-FECHA-MOVTO TO MV-FECHA.
029200     MOVE WS-DIAS-PERIODO TO MV-DIAS.
029300     MOVE CR-SALDO-CAP TO MV-SALDO-BASE.
029400     WRITE REG-MOVTO.
029500 2900-LEE-CREDITO.
029600     READ CREDITOS
029700         AT END MOVE 'S' TO WS-SW-FIN
029800     END-READ.
029900 7000-CALCULA-UDIS.
030000     COMPUTE WS-UDIS-IMPORTE ROUNDED =
030100         WS-INT-PERIODO / WS-UDIS-VALOR.
030200     IF ES-REPROCESO
030300         MOVE ZERO TO WS-UDIS-IMPORTE
030400     END-IF.
030500 9000-FIN.
030600     MOVE WS-CT-LEIDOS     TO LT-LEIDOS.
030700     MOVE WS-CT-ORDINARIO  TO LT-ORDINARIO.
030800     MOVE WS-CT-MORA       TO LT-MORA.
030900     MOVE WS-CT-ORDEN      TO LT-ORDEN.
031000     MOVE WS-CT-CONDONADO  TO LT-CONDONADO.
031100     MOVE WS-CT-SIN-TASA   TO LT-SIN-TASA.
031200     WRITE REG-REPORTE FROM WS-LIN-TOTAL.
031300     CLOSE CREDITOS PARAMS MOVTOS REPORTE CREDNVO.
